{#
    First choice: a passkey. Hidden by the script when the browser cannot create one;
    the authenticator app below always works.
#}
{% if hookable_metadata.context.passkeysEnabled|default(false) %}
    {% include '@CalmfoxSyliusAdminTwoFactorPlugin/passkey/_client.html.twig' %}

    <div class="calmfox-two-factor-choice calmfox-two-factor-choice--passkey mb-3" data-calmfox-passkey-setup hidden
         data-options-url="{{ path('calmfox_admin_two_factor_passkey_registration_options') }}"
         data-register-url="{{ path('calmfox_admin_two_factor_passkey_register') }}"
         data-csrf="{{ csrf_token('calmfox_admin_two_factor_passkey') }}"
         data-busy-label="{{ 'calmfox_admin_two_factor.ui.passkey_waiting'|trans }}"
         data-error-label="{{ 'calmfox_admin_two_factor.passkey.rejected'|trans({}, 'validators') }}">
        <div class="d-flex align-items-center gap-2 mb-1">
            <strong>{{ 'calmfox_admin_two_factor.ui.passkey_title'|trans }}</strong>
            <span class="badge bg-green-lt">{{ 'calmfox_admin_two_factor.ui.recommended'|trans }}</span>
        </div>
        <p class="text-secondary mb-2">{{ 'calmfox_admin_two_factor.ui.passkey_setup_lead'|trans }}</p>
        <div class="alert alert-danger" role="alert" data-error hidden></div>
        <button type="button" class="btn btn-primary w-100" data-start>
            {{ ux_icon('tabler:fingerprint', {class: 'icon'}) }}
            <span data-label>{{ 'calmfox_admin_two_factor.ui.passkey_use'|trans }}</span>
        </button>

        <div class="hr-text my-4">{{ 'calmfox_admin_two_factor.ui.or_authenticator_app'|trans }}</div>
    </div>

    <script>
        (() => {
            const root = document.currentScript.previousElementSibling;
            const passkey = window.CalmfoxPasskey;
            if (!passkey.supported()) return;
            root.hidden = false;

            const button = root.querySelector('[data-start]');
            const label = root.querySelector('[data-label]');
            const error = root.querySelector('[data-error]');
            const idle = label.textContent;

            button.addEventListener('click', async () => {
                error.hidden = true;
                button.disabled = true;
                label.textContent = root.dataset.busyLabel;
                try {
                    const { options } = await passkey.post(root.dataset.optionsUrl, root.dataset.csrf);
                    const credential = await passkey.create(options);
                    const { redirect } = await passkey.post(root.dataset.registerUrl, root.dataset.csrf, { credential, name: passkey.deviceName() });
                    window.location.assign(redirect);
                    return;
                } catch (e) {
                    if (!passkey.cancelled(e)) {
                        error.textContent = e.message || root.dataset.errorLabel;
                        error.hidden = false;
                    }
                }
                button.disabled = false;
                label.textContent = idle;
            });
        })();
    </script>
{% endif %}
