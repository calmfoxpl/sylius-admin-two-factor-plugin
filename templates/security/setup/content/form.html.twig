{% import '@SyliusAdmin/shared/helper/button.html.twig' as button %}
{% set form = hookable_metadata.context.form %}
{# with an e-mail code on its way, the cursor belongs in that field instead #}
{% set emailPending = hookable_metadata.context.email.pending|default(false) %}

{% form_theme form '@SyliusAdmin/shared/form_theme.html.twig' %}

{{ form_start(form, {'action': path('calmfox_admin_two_factor_setup'), 'attr': {'class': 'ui large loadable form', 'novalidate': 'novalidate'}}) }}
    {{ form_row(form.code, {attr: form.code.vars.attr|merge({class: 'form-control-lg text-center font-monospace', autofocus: not emailPending})}) }}
    {{ button.primary({ text: 'calmfox_admin_two_factor.ui.enable'|trans, type: 'submit', class: 'btn btn-primary w-100' }) }}
{{ form_end(form, {'render_rest': true}) }}
