{#
    "Two-factor authentication" card on the administrator edit page. It sits inside the edit
    form, so its buttons submit separate forms rendered outside it (two_factor_forms.html.twig).
#}
{% set adminUser = hookable_metadata.context.resource %}
{% set policy = calmfox_two_factor_policy() %}
{% set passkeys = adminUser.passkeyCredentials|default([]) %}
{% set hasApp = adminUser.totpAuthenticationEnabled|default(false) %}
{% set isMe = app.user is not null and app.user.id == adminUser.id %}

<div class="card mb-3">
    <div class="card-header">
        <div class="card-title">{{ 'calmfox_admin_two_factor.ui.two_factor_title'|trans }}</div>
        <div class="card-actions">
            <a href="{{ path('calmfox_admin_two_factor_settings') }}" class="text-secondary">
                {{ 'calmfox_admin_two_factor.settings.policy'|trans }}: {{ ('calmfox_admin_two_factor.settings.policy_' ~ policy ~ '_short')|trans }}
            </a>
        </div>
    </div>
    <div class="card-body">
        {% if policy == 'disabled' %}
            <div class="alert alert-info mb-3">{{ 'calmfox_admin_two_factor.ui.policy_disabled_note'|trans }}</div>
        {% endif %}

        <dl class="row mb-3">
            <dt class="col-5">{{ 'calmfox_admin_two_factor.ui.authenticator_app'|trans }}</dt>
            <dd class="col-7">{{ (hasApp ? 'calmfox_admin_two_factor.ui.paired' : 'calmfox_admin_two_factor.ui.not_paired')|trans }}</dd>

            <dt class="col-5">{{ 'calmfox_admin_two_factor.ui.passkey_title_plural'|trans }}</dt>
            <dd class="col-7">
                {% for passkey in passkeys %}
                    <div>
                        {{ ux_icon('tabler:fingerprint', {class: 'icon'}) }} {{ passkey.name }}
                        <span class="text-secondary small">
                            · {{ 'calmfox_admin_two_factor.ui.added'|trans }} {{ passkey.createdAt|date('Y-m-d') }}
                            {% if passkey.lastUsedAt %}· {{ 'calmfox_admin_two_factor.ui.last_used'|trans }} {{ passkey.lastUsedAt|date('Y-m-d H:i') }}{% endif %}
                        </span>
                    </div>
                {% else %}
                    {{ 'calmfox_admin_two_factor.ui.not_paired'|trans }}
                {% endfor %}
            </dd>

            {% if adminUser.twoFactorSetupRequired|default(false) %}
                <dt class="col-5">{{ 'calmfox_admin_two_factor.ui.status'|trans }}</dt>
                <dd class="col-7 text-warning">{{ 'calmfox_admin_two_factor.ui.pairing_pending_long'|trans }}</dd>
            {% endif %}
        </dl>

        <div class="btn-list">
            {% if isMe and policy != 'disabled' and not adminUser.twoFactorAuthentication %}
                <a href="{{ path('calmfox_admin_two_factor_setup') }}" class="btn btn-primary">
                    {{ ux_icon('tabler:shield-plus', {class: 'icon'}) }} {{ 'calmfox_admin_two_factor.ui.enable_now'|trans }}
                </a>
            {% endif %}

            <button type="submit" class="btn" form="calmfox-admin-two-factor-reset"
                    onclick="return confirm({{ 'calmfox_admin_two_factor.manage.reset_confirm'|trans({'%email%': adminUser.email})|json_encode }});">
                {{ ux_icon('tabler:refresh', {class: 'icon'}) }} {{ 'calmfox_admin_two_factor.manage.reset'|trans }}
            </button>

            {% if adminUser.twoFactorAuthentication or adminUser.twoFactorSetupRequired|default(false) %}
                <button type="submit" class="btn btn-outline-danger" form="calmfox-admin-two-factor-disable"
                        onclick="return confirm({{ 'calmfox_admin_two_factor.manage.disable_confirm'|trans({'%email%': adminUser.email})|json_encode }});">
                    {{ ux_icon('tabler:shield-off', {class: 'icon'}) }} {{ 'calmfox_admin_two_factor.manage.disable'|trans }}
                </button>
            {% endif %}
        </div>
        <div class="form-hint mt-2">{{ 'calmfox_admin_two_factor.manage.hint'|trans }}</div>
    </div>
</div>
